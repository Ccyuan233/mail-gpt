# Receiving bot account: must differ from ALLOWED_SENDERS.
EMAIL_ADDRESS=bot@gmail.com
# Gmail APP PASSWORD, never the account's main password.
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# ssl (465) or starttls (587); plaintext is unsupported.
SMTP_SECURITY=ssl
ALLOWED_SENDERS=user@example.com
IMAP_FOLDER=INBOX
# Optional YYYY-MM-DD. Otherwise the initial scan start is stored in SQLite.
# Read and unread matching messages since that date are both checked for deduplication.
IMAP_START_DATE=
DATABASE_PATH=./data/conversations.db
POLL_INTERVAL=30
MAX_MESSAGE_BYTES=1048576
MAX_PROMPT_CHARS=24000
MAX_REQUESTS_PER_HOUR=30
# Only trust the receiving provider's topmost Authentication-Results header.
REQUIRE_DMARC=true
AUTH_SERV_ID=mx.google.com
CODEX_PATH=codex
# Dedicated official CLI login and session storage; do not copy auth tokens.
BOT_CODEX_HOME=./data/codex-home
CODEX_WORKSPACE=./data/empty-workspace
CODEX_TIMEOUT=240
CODEX_MODEL=
# Fail closed on an unverified CLI version. See README before upgrading.
CODEX_EXPECTED_VERSION=0.153.4
